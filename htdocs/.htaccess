# =============================================
# JDC Auto - Configuration sécurité Apache
# =============================================

# Désactiver le listage des répertoires
Options -Indexes

# Forcer HTTPS : le mot de passe admin ne doit jamais transiter en clair.
# Derrière le proxy Gandi (Varnish), seul X-Forwarded-Proto est fiable —
# %{HTTPS} vaut "off" quand la requête arrive via le cache, ce qui boucle.
RewriteEngine On
RewriteCond %{HTTP:X-Forwarded-Proto} =http
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# SPA fallback : toutes les routes React → index.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ /index.html [L]

# Bloquer l'accès direct aux fichiers de configuration et aux secrets
# (mysql_gandi.php, *auth*.php, mais aussi *.local.php : tokens sync/backup/flux).
<FilesMatch "(admin_auth|mysql_gandi|backup_token|sync_token|spider_vo)(\.local)?\.php$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Reliquats de développement : ne doivent jamais être servis. Défense en profondeur,
# car le déploiement Gandi ne supprime pas les fichiers retirés du dépôt (un
# installateur /install/setup.php est resté exécutable en production pendant des mois).
RedirectMatch 404 ^/(install|test|test-mobile|index-simple|diagnostic|view_contacts|style\.txt)

# Bloquer l'accès direct au dossier config/
<IfModule mod_rewrite.c>
    RewriteRule ^config/ - [F,L]
</IfModule>

# Headers de sécurité
<IfModule mod_headers.c>
    # HSTS : les navigateurs n'essaieront plus jamais le site en HTTP (1 an)
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "same-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header always set X-XSS-Protection "1; mode=block"

    # Content-Security-Policy en mode RAPPORT SEUL : ne bloque rien, sert à repérer
    # les ressources non déclarées avant de passer en mode bloquant.
    # Sources du site : Sentry (erreurs JS), Google reCAPTCHA, EmailJS, photos Spider-VO.
    Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' https://www.google.com https://www.gstatic.com https://browser.sentry-cdn.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://spidervo.s3.fr-par.scw.cloud https://www.google.com https://www.gstatic.com; font-src 'self' data:; connect-src 'self' https://*.ingest.de.sentry.io https://*.sentry.io https://api.emailjs.com https://www.google.com; frame-src https://www.google.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
</IfModule>

# Empêcher l'accès aux fichiers sensibles
<FilesMatch "\.(env|log|sql|bak|backup|sh|md)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>
